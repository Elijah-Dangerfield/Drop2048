<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.dangerfield.drop2048.maintenance</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  Without this key the generated plist defaults CFBundleName to
	  $(PRODUCT_NAME), and App Store delivery rejects names that are
	  already taken by another app (ITMS-90129). Keep it set to the
	  app's display name; it must be unique on the App Store.
	-->
	<key>CFBundleName</key>
	<string>Doublestack</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>We'd like to send you notifications.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<!--
	  Custom-scheme deep links (`drop2048://…`), forwarded by .onOpenURL in
	  iOSApp.swift to DeepLinkBridge. No consumers yet — the template's were
	  all auth redirects, deleted with the identity stack.

	  Universal Links (https://...) require an `Associated Domains`
	  entitlement (`applinks:example.com`) plus an
	  apple-app-site-association file at https://example.com/.well-known/.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.dangerfield.drop2048</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>drop2048</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
