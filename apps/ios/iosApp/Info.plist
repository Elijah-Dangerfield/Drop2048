	<!--
	  The app's name is NOT here, and putting it back here will not work.
	  GENERATE_INFOPLIST_FILE is YES, and a key Xcode synthesizes overrides the
	  same key in this file without warning: a CFBundleName set here lost to the
	  generated $(PRODUCT_NAME) and shipped the app under its old name. Both keys
	  live in Configuration/Config.xcconfig now, CFBundleName as PRODUCT_NAME
	  itself (the generator takes it from nowhere else) and CFBundleDisplayName as
	  INFOPLIST_KEY_CFBundleDisplayName.
	-->
	<key>NSUserNotificationsUsageDescription</key>
	<string>We'd like to send you notifications.</string>
	<!--
	  AdMob reads this before any app code runs, which is why the ad unit ids
	  live in shared Kotlin (`AdUnits.kt`) and the *app* id lives here. This
	  is the real id of "Doublestack (iOS)" in the AdMob console (2026-09-21);
	  the units it pairs with are in `AdUnits.IosLive`, and
	  `AdUnits.useTestUnits` decides whether those or Google's samples are
	  requested. A missing key crashes the SDK at start; a wrong one silently
	  serves nothing.
	-->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-7008637445039253~9568808728</string>
	<!--
	  The App Tracking Transparency prompt. Shown before the first ad request
	  rather than at launch, so the player is asked at a moment where the
	  answer means something. Apple rejects builds that request the IDFA
	  without this key.
	-->
	<key>NSUserTrackingUsageDescription</key>
	<string>This lets us show ads that are more relevant to you. Doublestack is free because of them.</string>
