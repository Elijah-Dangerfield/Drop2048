<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SPEC 9's five haptic intensities go through HapticEngine.android.kt, which
      calls Vibrator directly rather than View.performHapticFeedback. That call
      requires this permission, and its absence is what the pre-existing
      MissingPermission lint errors on that file were about.

      C3a ran the control rather than assuming: with this line deleted, on an
      API 36 emulator, the vibrations still played. So the missing permission was
      *not* what had kept the haptics quiet — nothing had, and nobody had ever
      checked. The declaration stays because the API contract asks for it and
      because a platform that does enforce it fails silently, which is the worst
      way for this to break.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Auto Backup is off, and that is a data decision rather than a tidy-up.

      `AppData` holds `installId`, which is the only identity this app has: it
      is the `X-Install-Id` header our config server buckets rollouts on, the
      `install_id` attribute on every OTLP record, and a Sentry scope tag. Auto
      Backup would restore it onto a second device, so two phones would report
      as one install and land in one targeting bucket.

      It also makes the Settings copy true. "There is no backup and no way to
      undo this" (`settings_reset_warn_body`) is what the player reads before
      erasing their data, and with Auto Backup on, a restore hands it all back.

      The cost is real and accepted: a player who changes phones loses their run
      history. There is no account and no server-side copy (SPEC 20), so that is
      what the Settings copy already promises.
    -->
    <application
        android:name=".Drop2048Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drop2048">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|uiMode|keyboardHidden|smallestScreenSize|density|fontScale|locale">
            <!--
              configChanges: handle these changes inside Compose instead of
              letting Android recreate the Activity. Without this, the
              FloatingWindowNavigator instance passed to rememberNavController
              changes on recreation, which causes nav-compose to discard its
              saved back stack and pop the user to the start destination.
              All listed config changes are reactive in Compose (orientation,
              font scale, dark mode, density, locale), so the Activity does
              not need to recreate for them.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Custom-scheme deep links (`drop2048://…`). There are no consumers
              yet — the template's were all auth redirects, deleted with the
              identity stack. The filter stays so a route can claim a path
              without an AndroidManifest change.
              Per-route mapping happens via the `deepLinks` parameter on
              `screen<Route>` in the relevant FeatureEntryPoint; Compose
              NavHost reads `Activity.intent.data` automatically when a
              filter here matches.

              When adding App Links (https://, requires assetlinks.json on
              the host) sit them alongside this filter as a separate
              <intent-filter android:autoVerify="true"> block.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="drop2048" />
            </intent-filter>
        </activity>

        <!--
          The AdMob app id, which the SDK reads out of the manifest before any
          Kotlin runs — `MobileAds.initialize` throws at startup without it, and
          the crash is on the first launch of a build nobody has tested ads on.

          It is **not** in `AdUnits.kt` with the unit ids for exactly that
          reason: this one cannot be a Kotlin constant, because it is read too
          early. The value below is Google's published sample app id and it
          pairs with `AdUnits.useTestUnits`; both flip together when the real
          AdMob app exists. See `OWNER-TODO.md`.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>