    <!-- The ▼ control (decision D21). A content description, so it says what the
         press does rather than naming the glyph: it commits the block to the
         bottom of its column, and there is no taking it back. -->
    <string name="game_hard_drop">Drop to the bottom</string>
    <string name="game_board">Game board, %1$d columns by %2$d rows</string>
    <string name="game_falling_block">%1$s falling in column %2$d, landing in row %3$d</string>

    <!-- SPEC 13's opening beat outlines the cell the block has to reach. The
         outline is the whole instruction, so without this the card's "put it on
         the outline" says nothing at all to a screen reader. -->
    <string name="game_target_cell">Put the block in column %1$d</string>

    <!-- SPEC 8.2. "x2" is a multiplication sign in English and not in every locale,
         so this is a whole format string rather than a prefix plus a number. The
         same applies to every callout below: they are shouted, uppercase copy and
         a translator needs the whole line, not a stem to bolt a number onto. -->
    <string name="game_chain">CHAIN ×%1$d</string>
    <string name="game_callout_row_bust">ROW BUST!</string>
    <string name="game_callout_level">LEVEL %1$d</string>

