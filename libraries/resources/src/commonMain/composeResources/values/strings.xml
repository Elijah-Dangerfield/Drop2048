<resources>
    <string name="app_name">Doublestack</string>

    <!--
        The guided run (SPEC 13). Every drop of it is landed by the player's own
        drop input, because the drop clock is frozen and nothing else moves a
        block downward. The copy says so plainly rather than hinting. Since D21
        one drop finishes a block, so it says "drop" rather than "keep tapping".

        Three beats come in two versions. Drag is the default scheme, where the
        hard drop is a downward flick and there are no arrows on screen to name;
        a player who has switched the arrow row back on gets the arrow wording,
        because a tutorial has to teach the control the player is actually
        holding. Everything else here is written without naming a control at all,
        which is why there is no third copy of it.
    -->
    <string name="tutorial_steer_title">Put it on the outline</string>
    <string name="tutorial_steer_body_drag">Drag anywhere on the board. The block follows your finger.</string>
    <string name="tutorial_steer_body_arrows">The arrows walk the block across, one column a tap.</string>
    <string name="tutorial_first_drop_title">Now drop it</string>
    <string name="tutorial_first_drop_body_drag">Nothing falls on its own. Flick down and it goes straight to the bottom.</string>
    <string name="tutorial_first_drop_body_arrows">Nothing falls on its own. Tap ▼ and it goes straight to the bottom.</string>
    <string name="tutorial_first_merge_title">Four</string>
    <string name="tutorial_first_merge_body">Two matching numbers become one that is twice as big. That is the whole game.</string>
    <string name="tutorial_second_title">Again</string>
    <string name="tutorial_second_body_drag">Line it up, then flick down to put it there.</string>
    <string name="tutorial_second_body_arrows">Line it up, then tap ▼ to put it there.</string>
    <string name="tutorial_third_title">You will do that a lot</string>
    <string name="tutorial_third_body">It is how you set the pace instead of waiting for one.</string>
    <string name="tutorial_watch_title">Watch this one</string>
    <string name="tutorial_watch_body">Drop it wherever it fits.</string>
    <string name="tutorial_burst_title">Last one</string>
    <string name="tutorial_burst_body">512 onto 512 makes 1024. You can see what that makes.</string>
    <string name="tutorial_handoff_title">Now for real</string>
    <string name="tutorial_handoff_body">The clock starts. Blocks fall on their own from here.</string>
    <string name="tutorial_got_it">Got it</string>
    <string name="tutorial_ok">OK</string>
    <string name="tutorial_begin">Play</string>
    <string name="tutorial_skip">Skip tutorial</string>

